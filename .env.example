# Copy to .env (production) or .env.dev (development) and fill in the values.
#
# Application settings use the standard .NET form Section__Key, which binds straight onto the
# matching appsettings.json section (Postgres__Password -> Postgres:Password). There are no custom
# aliases: a key here is the same key in appsettings, compose, and the service's AGENTS.md.

# Postgres. docker-compose.yml hands these same values to the postgres container, so the database
# and the API can never be configured with different credentials. Compose overrides Host to
# the in-network service name.
Postgres__Host=localhost
Postgres__Port=5432
Postgres__Database=companyhq
Postgres__Username=companyhq
Postgres__Password=

# Redis. The redis container requires this password; compose composes it into the API's
# Cache__ConnectionString and the Web app's WEB_REDIS_URL. The line below is only for an API run
# outside Docker.
REDIS_PASSWORD=
Cache__ConnectionString=localhost:6379,password=${REDIS_PASSWORD}

Jwt__SigningKey=
Auth__WebBaseAddress=http://localhost:3004
Seed__Admin__Email=
Seed__Admin__Password=

Resend__ApiKey=
Resend__From=
Geo__UserAgent=CompanyHQ/1.0 (contact: contact@companyhq.app)

# Optional. Without them push delivery is disabled and the API still starts.
Firebase__ProjectId=
Firebase__ServiceAccountJson=

Cloudflare__R2__AccountId=
Cloudflare__R2__AccessKeyId=
Cloudflare__R2__SecretAccessKey=
Cloudflare__R2__Bucket=
# Set to a public R2 domain to serve media from it; otherwise media is served through the API.
Media__PublicBaseUrl=
Media__ContentBaseUrl=http://localhost:4002

Marketing__Origins__0=http://localhost:3003

# Ports: Marketing 3003, Web 3004, API 4002
MARKETING_PORT=3003
WEB_PORT=3004
API_PORT=4002
API_DEV_PORT=4002
REDIS_DEV_PORT=6379

PUBLIC_API_URL=http://localhost:4002
PUBLIC_WEB_URL=http://localhost:3004
MARKETING_URL=http://localhost:3003
WEB_API_INTERNAL_URL=http://api:8080
