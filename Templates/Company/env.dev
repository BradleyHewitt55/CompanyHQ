# Development values, read by StartDev. Fill in every value; keep the file private.
#
# Keys use the standard .NET form Section__Key (Postgres__Password -> Postgres:Password). Compose
# hands the same file to the database and the API, so they cannot disagree on credentials.
# Production values go in .env, read by StartProd; the two modes keep separate databases.

# Changing this after the database volume exists does nothing; the image applies it only once.
Postgres__Password=
# Base64-encoded 32-byte keys (openssl rand -base64 32).
Jwt__SigningKey=
Demo__StorageSigningKey=

# The administrator created when the API first starts against an empty database.
Seed__Admin__Email=admin@example.test
Seed__Admin__Password=
Seed__Admin__FirstName=Company
Seed__Admin__LastName=Admin

# A GitHub token with read:packages; downloads the CompanyHQ packages when the API is built.
COMPANYHQ_PACKAGES_TOKEN=
