<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exactly the generic packages this API uses, at the one pinned release. Add a module by adding
         its package (and its Contracts package) here at the same version, then register it in Program.cs. -->
    <PackageReference Include="CompanyHQ.Rss" Version="[$(CompanyHQVersion)]" />
    <PackageReference Include="CompanyHQ.Rss.Contracts" Version="[$(CompanyHQVersion)]" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Its default transitive Microsoft.OpenApi 2.0.0 carries a high-severity advisory (NU1903). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>
</Project>
