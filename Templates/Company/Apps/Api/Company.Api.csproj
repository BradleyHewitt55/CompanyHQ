<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <ProjectReference Include="../../.companyhq/source/Apps/Api/Api.csproj" />
    <Compile Include="../../.companyhq/source/Apps/Api/Integrations/*.cs" Link="Integrations/%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Reference the HQ host for migrations, not its deployment settings. -->
  <Target Name="ExcludeUpstreamSettings" BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <_UpstreamSettings Include="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../.companyhq/source/Apps/Api'))/appsettings*.json" />
      <ResolvedFileToPublish Remove="@(_UpstreamSettings)" />
      <!-- Model discovery reads the migration host's dependency graph after publication. -->
      <ResolvedFileToPublish Include="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../.companyhq/source/Apps/Api'))/bin/$(Configuration)/net10.0/Api.deps.json" RelativePath="Api.deps.json" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
