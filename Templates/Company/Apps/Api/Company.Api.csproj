<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Emitting the contracts boots the host, so only the image build turns it on. -->
    <OpenApiGenerateDocumentsOnBuild Condition=" '$(OpenApiGenerateDocumentsOnBuild)' == '' ">false</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <!-- Brings every generic service, their bridges and the shared HTTP filters. -->
    <PackageReference Include="CompanyHQ.Api" Version="[$(CompanyHQVersion)]" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.10" PrivateAssets="all" />
    <!-- Design-time only: `dotnet ef` writes the migrations for this company's schema. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" PrivateAssets="all" />
  </ItemGroup>
</Project>
