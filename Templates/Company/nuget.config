<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="companyhq" value="https://nuget.pkg.github.com/BradleyHewitt55/index.json" />
  </packageSources>
  <!-- Only CompanyHQ packages come from GitHub, so nothing else needs its token. -->
  <packageSourceMapping>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
    <packageSource key="companyhq"><package pattern="CompanyHQ.*" /></packageSource>
  </packageSourceMapping>
  <!-- GitHub Packages requires a token with read:packages even to download. -->
  <packageSourceCredentials>
    <companyhq>
      <add key="Username" value="token" />
      <add key="ClearTextPassword" value="%COMPANYHQ_PACKAGES_TOKEN%" />
    </companyhq>
  </packageSourceCredentials>
</configuration>
