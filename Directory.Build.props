<Project>
  <!-- One version for every published CompanyHQ package; raise it to release. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>CompanyHQ</Authors>
    <!-- GitHub Packages attaches a package to the repository named here. -->
    <RepositoryUrl>https://github.com/BradleyHewitt55/CompanyHQ</RepositoryUrl>
  </PropertyGroup>
</Project>
