# Server-side API URL. Direct local Web development uses the host-published API.
API_INTERNAL_URL=http://localhost:4002
# Server-side Redis URL. Direct local Web development uses the host-published dev Redis and the
# REDIS_PASSWORD from the root .env.dev.
WEB_REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379
# Browser-reachable Marketing URL used by the Web auth pages.
MARKETING_URL=http://localhost:3003
# Optional. Only set once the native applications are available.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
