{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Postgres": {
    "Host": "localhost",
    "Port": 5432,
    "Database": "companyhq",
    "Username": "companyhq",
    "AutoMigrate": true,
    "AutoSeed": false
  },
  "Cache": {
    "Host": "localhost",
    "Port": 6379,
    "KeyPrefix": "companyhq:",
    "DefaultTtlSeconds": 300
  },
  "Geo": {
    "BaseAddress": "https://nominatim.openstreetmap.org/",
    "OverpassBaseAddress": "https://overpass-api.de/",
    "UserAgent": "CompanyHQ/1.0 (contact@companyhq.app)",
    "AreaZoom": 10,
    "Language": "en",
    "CacheTtlHours": 24,
    "NearbyPlaceCacheTtlHours": 6,
    "NearbyTileHardTtlHours": 72
  },
  "Marketing": {
    "Origins": [
      "https://companyhq.app"
    ]
  },
  "Jwt": {
    "Issuer": "CompanyHQ",
    "Audience": "CompanyHQ",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Mcp": {
    "OAuth": {
      "PublicWebBaseAddress": "https://app.companyhq.co.za",
      "AuthorizationServerBaseAddress": "https://companyhq.co.za",
      "ResourceAddress": "https://companyhq.co.za/mcp",
      "AuthorizationCodeMinutes": 5,
      "AccessTokenMinutes": 43200,
      "RefreshTokenDays": 30
    }
  }
}
