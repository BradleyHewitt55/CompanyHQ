<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CompanyHQ.Services.Company</AssemblyName>
    <RootNamespace>CompanyHQ.Services.Company</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Postgres\Postgres.csproj" />
    <ProjectReference Include="..\User\User.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Contracts\**" />
    <Compile Include="Contracts\Models\**\*.cs" />
    <ProjectReference Include="Contracts\Company.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Auth's identity helpers (User.GetUserId(), claim names) only; Auth itself is never referenced. -->
    <ProjectReference Include="..\Auth\Contracts\Auth.Contracts.csproj" />
  </ItemGroup>

</Project>
