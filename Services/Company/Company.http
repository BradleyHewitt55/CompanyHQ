@host = http://localhost:8080
@adminToken = {{$dotenv ADMIN_ACCESS_TOKEN}}

### Read the profile (anonymous). 404 until an administrator saves one.
GET {{host}}/api/company

### Save the profile.
PUT {{host}}/api/company
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "CompanyHQ",
  "website": "https://companyhq.app",
  "supportEmail": "support@companyhq.app",
  "infoEmail": "info@companyhq.app",
  "logoUrl": "https://cdn.example.test/companyhq.svg",
  "description": "Consulting and operations support for growing teams."
}

### Save with a blank name: 400.
PUT {{host}}/api/company
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "",
  "website": "https://companyhq.app",
  "supportEmail": "support@companyhq.app",
  "infoEmail": "info@companyhq.app",
  "logoUrl": null,
  "description": "Consulting and operations support for growing teams."
}

### Save without an administrator token: 401/403.
PUT {{host}}/api/company
Content-Type: application/json

{
  "name": "CompanyHQ",
  "website": "https://companyhq.app",
  "supportEmail": "support@companyhq.app",
  "infoEmail": "info@companyhq.app",
  "logoUrl": "https://cdn.example.test/companyhq.svg",
  "description": "Consulting and operations support for growing teams."
}

### Publish titled company contact addresses (first two match support/info)
PUT {{host}}/api/company
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name":"CompanyHQ","website":"https://companyhq.app",
  "supportEmail":"support@companyhq.app","infoEmail":"info@companyhq.app",
  "description":"Consulting and operations support for growing teams.",
  "publicEmails":[
    {"title":"Support","address":"support@companyhq.app","description":"Help with your account"},
    {"title":"Information","address":"info@companyhq.app"},
    {"title":"Sales","address":"sales@companyhq.app","description":"Discuss your requirements"}
  ]
}

### Invalid public address: 400, existing profile unchanged
PUT {{host}}/api/company
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name":"CompanyHQ","website":"https://companyhq.app",
  "supportEmail":"support@companyhq.app","infoEmail":"info@companyhq.app",
  "description":"Consulting and operations support for growing teams.",
  "publicEmails":[{"title":"Support","address":"support@companyhq.app"},{"title":"Information","address":"info@companyhq.app"},{"title":"Sales","address":"invalid"}]
}

### Safe navigation for any signed-in account (only current permitted enabled entries).
GET {{host}}/api/company/navigation
Authorization: Bearer {{adminToken}}

### Navigation without authentication: 401.
GET {{host}}/api/company/navigation

### List the allowed catalog before a public company profile exists.
GET {{host}}/api/company/services
Authorization: Bearer {{adminToken}}

### Get description, providers, readiness and configuration-key metadata (never values).
GET {{host}}/api/company/services/sales
Authorization: Bearer {{adminToken}}

### Unknown descriptor: 404.
GET {{host}}/api/company/services/not-allowlisted
Authorization: Bearer {{adminToken}}

### Disable sales; following HTTP, MCP and domain admissions are absent immediately.
PUT {{host}}/api/company/services/sales
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "enabled": false }

### Enable sales immediately; configuration/provider changes can still require restart.
PUT {{host}}/api/company/services/sales
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "enabled": true }

### Protected core: 409 CoreService.
PUT {{host}}/api/company/services/email
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "enabled": false }

### Provider selection retains old environment credentials and pauses incompatible transport.
PUT {{host}}/api/company/services/email
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "enabled": true, "selectedProvider": "localsmtp" }

### Unsafe media switch: 409 UnsafeProviderChange (existing objects lack provider affinity).
PUT {{host}}/api/company/services/media
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "enabled": true, "selectedProvider": "local" }

### Unknown provider: 409 UnknownProvider.
PUT {{host}}/api/company/services/email
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "enabled": true, "selectedProvider": "unknown" }

### Enabled Messages still requires Moderation: 409 RequiredByEnabledService.
PUT {{host}}/api/company/services/moderation
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "enabled": false }

### Management without a token: 401. A current role without company.services.manage gets 403.
GET {{host}}/api/company/services
