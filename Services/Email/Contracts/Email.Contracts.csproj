<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CompanyHQ.Services.Email.Contracts</AssemblyName>
    <RootNamespace>CompanyHQ.Services.Email.Contracts</RootNamespace>
  </PropertyGroup>

  <!--
    The wire shapes and ports other services and adapters reference instead of the Email service
    itself, with no dependency of any kind. The persisted entities stay compiled into the service.
  -->
  <ItemGroup>
    <Compile Remove="Models/**" />
  </ItemGroup>

</Project>
