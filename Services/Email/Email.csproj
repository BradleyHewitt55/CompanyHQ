<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CompanyHQ.Services.Email</AssemblyName>
    <RootNamespace>CompanyHQ.Services.Email</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Persisted through the provider-neutral ports; the database provider is never referenced. -->
    <ProjectReference Include="..\Persistence\Persistence.csproj" />
    <!-- Shared wire contracts only: paging, search, response audiences and permission names. -->
    <ProjectReference Include="..\Postgres\Contracts\Postgres.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contracts/ is its own dependency-free assembly; only the persisted entities under it compile
         into this one. -->
    <Compile Remove="Contracts/**" />
    <Compile Include="Contracts/Models/**/*.cs" />
    <ProjectReference Include="Contracts/Email.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mapping only: the entity configurations under Data/ describe this service's tables, indexes
         and column types. Nothing outside Data/ may use EF Core, and no database driver is referenced. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Templates\**\*.html"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Always" />
    <EmbeddedResource Include="Templates\**\*.html" />
  </ItemGroup>

  <ItemGroup>
    <!-- Auth's identity helpers (User.GetUserId(), claim names) only; Auth itself is never referenced. -->
    <ProjectReference Include="..\Auth\Contracts\Auth.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Attributes for this service's own MCP tool adapter (Mcp/); Mcp discovers it from this assembly. -->
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Delivery goes through the official Resend client. The host registers it (AddResend) before
         AddEmail; this service never holds the API key. -->
    <PackageReference Include="Resend" Version="0.23.0" />
  </ItemGroup>

</Project>
