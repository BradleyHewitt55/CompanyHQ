<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CompanyHQ.Sales.Contracts</AssemblyName>
    <RootNamespace>CompanyHQ.Sales.Contracts</RootNamespace>
  </PropertyGroup>

  <!-- Wire shapes and ports only, with no framework, database or provider dependency. The persisted
       entities and bound options stay behind in the service assembly. -->
  <ItemGroup>
    <Compile Remove="Models/**" />
    <ProjectReference Include="..\..\Postgres\Contracts\Postgres.Contracts.csproj" />
  </ItemGroup>

</Project>
