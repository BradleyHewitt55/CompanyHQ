# Replace IDs with persisted catalog/order/method IDs. Requests are manual examples.
# Send endpoints invoke the configured delivery provider; use a test adapter for verification.
@host = http://localhost:4002
@accessToken = replace-with-manager-bearer-token
@guestToken = replace-with-receipt-guestAccessToken
@productId = 11111111-1111-4111-8111-111111111111
@variantId = 22222222-2222-4222-8222-222222222222
@lineId = 33333333-3333-4333-8333-333333333333
@id = 44444444-4444-4444-8444-444444444444
@reviewId = 55555555-5555-4555-8555-555555555555
@methodId = 66666666-6666-4666-8666-666666666666
@originId = 77777777-7777-4777-8777-777777777777
@sizeOptionId = 88888888-8888-4888-8888-888888888888
@colorOptionId = 99999999-9999-4999-8999-999999999999
@requestId = aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
@slug = desk
@quoteValidUntil = 2026-11-14T00:00:00Z
### GET products
GET {{host}}/api/sales/products?page=1&pageSize=10
Accept: application/json

### Invalid price range (400)
GET {{host}}/api/sales/products?minPrice=150&maxPrice=50
Accept: application/json

### GET products/{slug}
GET {{host}}/api/sales/products/{{slug}}
Accept: application/json

### Missing record (404)
GET {{host}}/api/sales/products/missing-product
Accept: application/json

### POST products
POST {{host}}/api/sales/products
Authorization: Bearer {{accessToken}}
Accept: application/json
Content-Type: application/json

{
  "name": "Desk",
  "slug": "desk",
  "currency": "USD",
  "variants": [
    {
      "id": "{{variantId}}",
      "sku": "desk-oak",
      "cost": 100,
      "profitPercentage": 50,
      "options": {
        "Size": "Small",
        "Color": "Oak"
      }
    }
  ],
  "options": [
    {
      "id": "{{sizeOptionId}}",
      "name": "Size",
      "values": [
        "Small"
      ]
    },
    {
      "id": "{{colorOptionId}}",
      "name": "Color",
      "values": [
        "Oak"
      ],
      "dependencyOptionIds": [
        "{{sizeOptionId}}"
      ]
    }
  ],
  "relatedProductIds": []
}

