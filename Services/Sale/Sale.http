### POST orders/{id:guid}/invoice/send
# A request id permanently binds this invoice's recipient, reference and payload. Reuse it on
# retry, including after staff repricing; use a fresh id to snapshot a newly revised invoice.
# 200 {accepted:false,queued:true} means awaiting the email provider. Repeat this request to
# refresh the outcome; accepted:true means provider acceptance, never final inbox delivery.
POST {{host}}/api/sales/orders/{{id}}/invoice/send
Authorization: Bearer {{accessToken}}
Accept: application/json
Content-Type: application/json

{
  "requestId": "{{requestId}}"
}

### Missing authentication (401)
POST {{host}}/api/sales/orders/{{id}}/invoice/send
Accept: application/json
Content-Type: application/json

{
  "requestId": "{{requestId}}"
}

### POST quotes/{id:guid}/send
# Queue success leaves the quote Issuing. Repeat the send to observe provider acceptance;
# only then does automatic issuing mark it Sent. The frozen document/key survive retries.
POST {{host}}/api/sales/quotes/{{id}}/send
Authorization: Bearer {{accessToken}}
Accept: application/json
Content-Type: application/json

{
  "requestId": "{{requestId}}"
}

