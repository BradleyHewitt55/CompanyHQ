<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CompanyHQ.Services.Cache.Contracts</AssemblyName>
    <RootNamespace>CompanyHQ.Services.Cache.Contracts</RootNamespace>
  </PropertyGroup>

  <!--
