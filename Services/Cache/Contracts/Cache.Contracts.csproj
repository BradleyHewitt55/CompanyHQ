<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CompanyHQ.Services.Cache.Contracts</AssemblyName>
    <RootNamespace>CompanyHQ.Services.Cache.Contracts</RootNamespace>
  </PropertyGroup>

  <!--
    The port a cache provider adapter implements, with no dependency of any kind. An adapter
    references this assembly and nothing else of Cache. The options stay compiled into the service.
  -->
  <ItemGroup>
    <Compile Remove="Models/**" />
  </ItemGroup>

</Project>
