<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CompanyHQ.Cache</AssemblyName>
    <RootNamespace>CompanyHQ.Cache</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- Entries are stored through the official Redis client. The host registers its
         IConnectionMultiplexer before AddCache; this service never builds the connection. -->
    <PackageReference Include="StackExchange.Redis" Version="2.13.17" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contracts/ is its own assembly holding the provider port; only the options under it
         compile into this one. -->
    <Compile Remove="Contracts/**" />
    <Compile Include="Contracts/Models/**/*.cs" />
    <ProjectReference Include="Contracts/Cache.Contracts.csproj" />
  </ItemGroup>

</Project>
