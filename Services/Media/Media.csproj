<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CompanyHQ.Services.Media</AssemblyName>
    <RootNamespace>CompanyHQ.Services.Media</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Persisted through the provider-neutral ports; the database provider is never referenced. -->
    <ProjectReference Include="..\Persistence\Persistence.csproj" />
    <!-- Shared wire contracts only: paging, search, response audiences and permission names. -->
    <ProjectReference Include="..\Postgres\Contracts\Postgres.Contracts.csproj" />
    <ProjectReference Include="..\User\User.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contracts/ is its own client-shippable assembly. Only the persisted entities and
         the entity-to-DTO projections under it compile into this one. -->
    <Compile Remove="Contracts/**" />
    <Compile Include="Contracts/Models/**/*.cs" />
    <ProjectReference Include="Contracts/Media.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Auth's identity helpers (User.GetUserId(), claim names) only; Auth itself is never referenced. -->
    <ProjectReference Include="..\Auth\Contracts\Auth.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Objects are stored through the official AWS S3 client, which also speaks to Cloudflare R2.
         The host registers its IAmazonS3 before AddMedia; this service never holds the credentials. -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mapping only: the entity configurations under Data/ describe this service's tables, indexes
         and column types. Nothing outside Data/ may use EF Core, and no database driver is referenced. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
  </ItemGroup>

</Project>
