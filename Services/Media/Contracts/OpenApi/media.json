  "components": {
    "schemas": {
      "AdminMediaObjectDto": {
        "required": [
          "ownerUserId",
          "key",
          "updatedAt",
          "id",
          "scope",
          "contentType",
          "sizeBytes",
          "status",
          "downloadUrl"
        ],
        "type": "object",
        "properties": {
          "ownerUserId": {
            "type": "string",
            "format": "uuid"
          },
          "key": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "scope": {
            "$ref": "#/components/schemas/MediaScope"
          },
          "contentType": {
            "type": "string"
          },
          "sizeBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "status": {
            "$ref": "#/components/schemas/MediaStatus"
          },
          "downloadUrl": {
            "type": "string"
          }
        }
      },
      "CreateMediaUploadRequest": {
        "required": [
          "scope",
          "contentType",
          "sizeBytes"
        ],
        "type": "object",
        "properties": {
          "scope": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MediaScope"
              }
            ]
          },
          "contentType": {
            "type": "string"
          },
          "sizeBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "MediaScope": {
        "enum": [
          "Message",
          "User",
          "Content",
          null
        ]
      },
      "MediaStatus": {
        "enum": [
          "Pending",
          "Ready",
          "Failed",
          "Deleted"
        ]
      },
      "MediaUploadTicketDto": {
        "required": [
          "mediaObjectId",
          "uploadUrl",
          "url",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "mediaObjectId": {
            "type": "string",
            "format": "uuid"
          },
          "uploadUrl": {
            "type": "string"
          },
          "url": {
            "type": [
              "null",
              "string"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
