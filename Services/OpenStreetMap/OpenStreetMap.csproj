<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CompanyHQ.OpenStreetMap</AssemblyName>
    <RootNamespace>CompanyHQ.OpenStreetMap</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The adapter implements Geo's IGeoProvider port and references nothing else of Geo. -->
    <ProjectReference Include="..\Geo\Contracts\Geo.Contracts.csproj" />
  </ItemGroup>

</Project>
