<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CompanyHQ.Services.Faqs</AssemblyName>
    <RootNamespace>CompanyHQ.Services.Faqs</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Postgres\Postgres.csproj" />
    <ProjectReference Include="..\User\User.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Contracts\**" />
    <Compile Include="Contracts\Models\**\*.cs" />
    <Compile Include="Contracts\Dtos\FaqEntryProjections.cs" />
    <ProjectReference Include="Contracts\Faq.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Auth's identity helpers (User.GetUserId(), claim names) only; Auth itself is never referenced. -->
    <ProjectReference Include="..\Auth\Contracts\Auth.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Attributes for this service's own MCP tool adapter (Mcp/); Mcp discovers it from this assembly. -->
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
  </ItemGroup>

</Project>
