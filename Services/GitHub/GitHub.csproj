<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CompanyHQ.GitHub</AssemblyName>
    <RootNamespace>CompanyHQ.GitHub</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Persisted through the provider-neutral ports; the database provider is never referenced. -->
    <ProjectReference Include="..\Persistence\Persistence.csproj" />
    <!-- Shared wire contracts only: paging, search, response audiences and permission names. -->
    <ProjectReference Include="..\Postgres\Contracts\Postgres.Contracts.csproj" />
    <ProjectReference Include="..\User\User.csproj" />
    <!-- Auth's identity helpers (User.GetUserId(), claim names) only; Auth itself is never referenced. -->
    <ProjectReference Include="..\Auth\Contracts\Auth.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contracts/ is its own client-shippable assembly. Only the persisted entity and the options
         under it compile into this one. -->
    <Compile Remove="Contracts/**" />
    <Compile Include="Contracts/Models/**/*.cs" />
    <ProjectReference Include="Contracts/GitHub.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mapping only: the entity configurations under Data/ describe this service's tables, indexes
         and column types. Nothing outside Data/ may use EF Core, and no database driver is referenced. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- GitHub's own client. The token is stored per connection, so the service builds a client per
         call rather than taking one from the host. -->
    <PackageReference Include="Octokit" Version="14.0.0" />
  </ItemGroup>

</Project>
