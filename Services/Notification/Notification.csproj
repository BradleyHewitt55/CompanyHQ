<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CompanyHQ.Notifications</AssemblyName>
    <RootNamespace>CompanyHQ.Notifications</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Auth\Contracts\Auth.Contracts.csproj" />
    <!-- Persisted through the provider-neutral ports; the database provider is never referenced. -->
    <ProjectReference Include="..\Persistence\Persistence.csproj" />
    <!-- Shared wire contracts only: paging, search, response audiences and permission names. -->
    <ProjectReference Include="..\Postgres\Contracts\Postgres.Contracts.csproj" />
    <ProjectReference Include="..\User\User.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contracts/ is its own client-shippable assembly. Only the persisted entities and
         the entity-to-DTO projections under it compile into this one. -->
    <Compile Remove="Contracts/**" />
    <Compile Include="Contracts/Models/**/*.cs" />
    <ProjectReference Include="Contracts/Notification.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Attributes for this service's own MCP tool adapter (Mcp/); Mcp discovers it from this assembly. -->
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Push goes through the official Firebase Admin SDK. This service builds the FirebaseApp from
         the optional Firebase section; without credentials push is disabled. -->
    <PackageReference Include="FirebaseAdmin" Version="3.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mapping only: the entity configurations under Data/ describe this service's tables, indexes
         and column types. Nothing outside Data/ may use EF Core, and no database driver is referenced. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup><ProjectReference Include="..\ServiceCatalog\ServiceCatalog.csproj" /></ItemGroup>
</Project>
