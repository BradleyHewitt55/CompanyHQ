<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CompanyHQ.Services.Users</AssemblyName>
    <RootNamespace>CompanyHQ.Services.Users</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Carries both the controllers this service ships and IPasswordHasher; the full Identity stack
      would bring its own entities and DbContext, which the Postgres service already owns.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Postgres\Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contracts/ is its own client-shippable assembly. Only the persisted entities and
         the entity-to-DTO projections under it compile into this one. -->
    <Compile Remove="Contracts/**" />
    <Compile Include="Contracts/Models/**/*.cs" />
    <Compile Include="Contracts/Dtos/UserProjections.cs" />
    <ProjectReference Include="Contracts/User.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Auth's identity helpers (User.GetUserId(), claim names) only; Auth itself is never referenced. -->
    <ProjectReference Include="..\Auth\Contracts\Auth.Contracts.csproj" />
  </ItemGroup>

</Project>
