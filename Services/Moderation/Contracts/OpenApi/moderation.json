  "components": {
    "schemas": {
      "AccountFlagStatus": {
        "enum": [
          "Active",
          "Cleared",
          "Upheld"
        ]
      },
      "AdminLinkedContentReportDto": {
        "required": [
          "id",
          "reporterUserId",
          "reason",
          "details",
          "status",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reporterUserId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "$ref": "#/components/schemas/ReportReason"
          },
          "details": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/ReportStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AdminReportDecisionDto": {
        "required": [
          "administratorUserId",
          "previousStatus",
          "newStatus",
          "note",
          "decidedAt"
        ],
        "type": "object",
        "properties": {
          "administratorUserId": {
            "type": "string",
            "format": "uuid"
          },
          "previousStatus": {
            "$ref": "#/components/schemas/ReportStatus"
          },
          "newStatus": {
            "$ref": "#/components/schemas/ReportStatus"
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          },
          "decidedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AdminReportedContentSnapshotDto": {
        "required": [
          "authorUserId",
          "body",
          "occurredAt",
          "isTarget"
        ],
        "type": "object",
        "properties": {
          "authorUserId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "body": {
            "type": "string"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "isTarget": {
            "type": "boolean"
          }
        }
      },
      "BlockUserRequest": {
        "required": [
          "blockedUserId"
        ],
        "type": "object",
        "properties": {
          "blockedUserId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ClientAccountFlagDto": {
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/components/schemas/ClientAccountFlagDtoAdminAccountFlagDto"
          },
          {
            "$ref": "#/components/schemas/ClientAccountFlagDtoBase"
          }
        ]
      },
      "ClientAccountFlagDtoAdminAccountFlagDto": {
        "required": [
          "raisedBy",
          "raisedByUserId",
          "evidence",
          "clearedByUserId",
          "clearedAt",
          "reviewNote",
          "id",
          "userId",
          "kind",
          "status",
          "createdAt"
        ],
        "properties": {
          "raisedBy": {
            "$ref": "#/components/schemas/FlagOrigin"
          },
          "raisedByUserId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "evidence": {
            "type": "string"
          },
