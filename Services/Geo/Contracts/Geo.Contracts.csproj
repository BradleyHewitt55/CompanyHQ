<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CompanyHQ.Services.Geo.Contracts</AssemblyName>
    <RootNamespace>CompanyHQ.Services.Geo.Contracts</RootNamespace>
  </PropertyGroup>

  <!--
    The wire shapes this service speaks, with no dependency on the ASP.NET Core shared
    framework, EF Core or Npgsql. Apps/Mobile targets net10.0-android where none of those
    exist, so anything reaching for one belongs in the service assembly, not here. That is
    why persisted entities and the entity-to-DTO projections stay behind.
  -->
  <ItemGroup>
    <Compile Remove="Models/GeoOptions.cs" />
    <Compile Remove="Dtos/Nominatim*.cs" />
    <Compile Remove="Dtos/Overpass*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Postgres\Contracts\Postgres.Contracts.csproj" />
  </ItemGroup>

</Project>
