@page "/admin"
@page "/admin/{**Path}"
@rendermode InteractiveServer
@inject ComponentRegistry Registry
@inject IConfiguration Configuration

@inject LayoutRegistry LayoutRegistry

<LayoutView Layout="@ResolveLayout()">
    @if (overrideMarkup is not null) { <section data-admin-override="@RouteName">@((MarkupString)overrideMarkup)</section> }
    else { <DynamicComponent Type="ResolvedComponent" /> }
</LayoutView>

@code {
    [Parameter] public string? Path { get; set; }
    private string? overrideMarkup;
    private string RouteName => string.IsNullOrWhiteSpace(Path) ? "dashboard" : Path;
    private Type ResolvedComponent => Registry.Resolve(string.IsNullOrWhiteSpace(Path) ? "dashboard" : Path);
    protected override void OnParametersSet()
    {
        overrideMarkup = null;
        var root = System.IO.Path.GetFullPath(Configuration["AdminPagesPath"] ?? "/app/company/Admin/Pages");
        var file = System.IO.Path.GetFullPath(System.IO.Path.Combine(root, RouteName.Replace('/', System.IO.Path.DirectorySeparatorChar) + ".html"));
        if (file.StartsWith(root + System.IO.Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase) && File.Exists(file)) overrideMarkup = File.ReadAllText(file);
    }
    private Type ResolveLayout()
    {
        if (string.Equals(Path, "companies", StringComparison.OrdinalIgnoreCase))
            return LayoutRegistry.Resolve("CompanyLayout");
        try { return LayoutRegistry.Resolve("AdminLayout"); }
        catch (KeyNotFoundException) { return typeof(Web.Admin.Components.AdminLayout); }
    }
}
