@inject IServiceCatalog Services
@inject global::Services.Companies.Contracts.Services.IServiceScaffolding Scaffolding
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider Authentication
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@implements IDisposable

<aside class="file-explorer" aria-label="File explorer">
    <div class="file-explorer-header">Explorer</div>
    <div class="tree-item @(adminOpen ? "open" : null)">
        <button class="tree-label" aria-expanded="@adminOpen.ToString().ToLowerInvariant()" @onclick="() => adminOpen = !adminOpen"><span class="chevron">›</span> Admin</button>
        <div class="tree-children"><div class="tree-row"><span>Pages</span></div>@TreeServices(Services.GetServices(), true)</div>
    </div>
    <div class="tree-item @(projectsOpen ? "open" : null)">
        <button class="tree-label" aria-expanded="@projectsOpen.ToString().ToLowerInvariant()" @onclick="() => projectsOpen = !projectsOpen"><span class="chevron">›</span> Projects</button>
        @if (canManage) { <button class="tree-add" aria-label="Add Project" @onclick="AddItem" @onclick:stopPropagation>+</button> }
        <div class="tree-children"><div class="tree-item open"><button class="tree-label" aria-expanded="true"><span class="chevron">›</span> Website</button><div class="tree-children"><div class="tree-row"><span>Pages</span></div><div class="tree-row"><span>Services</span>@if (canManage) { <button aria-label="Add Website service" @onclick="AddItem" @onclick:stopPropagation>+</button> }</div></div></div></div>
    </div>
</aside>
@if (canManage && addingTo is not null)
{
    <div class="catalog-popover" role="dialog"><h3>Add service</h3>@foreach (var template in Scaffolding.Templates){<button @onclick="() => Create(template)">@template.Name</button>}<button @onclick="() => addingTo = null">Cancel</button></div>
}

@code {
    private bool adminOpen = true;
    private bool projectsOpen = true;
    private string? addingTo;
    private bool canManage;
    private void AddItem() => addingTo = "Admin";
    private async Task Create(global::Services.Companies.Contracts.Services.ServiceTemplateInfo template)
    {
        if (!(await Authorization.AuthorizeAsync((await Authentication.GetAuthenticationStateAsync()).User, null, "ManageUsers")).Succeeded) return;
        var name = string.Concat(template.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(word => char.ToUpperInvariant(word[0]) + word[1..]));
        await Scaffolding.Create(name, addingTo ?? "Admin");
        addingTo = null;
    }
    protected override async Task OnInitializedAsync()
    {
        Services.Changed += ServicesChanged;
        canManage = (await Authorization.AuthorizeAsync((await Authentication.GetAuthenticationStateAsync()).User, null, "ManageUsers")).Succeeded;
    }
    private void ServicesChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Services.Changed -= ServicesChanged;
    private RenderFragment TreeServices(IReadOnlyList<ServiceSummary> services, bool root) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "div"); builder.AddAttribute(sequence++, "class", "tree-item open");
        builder.OpenElement(sequence++, "div"); builder.AddAttribute(sequence++, "class", "tree-row"); builder.OpenElement(sequence++, "span"); builder.AddContent(sequence++, "Services"); builder.CloseElement();
        if (canManage) { builder.OpenElement(sequence++, "button"); builder.AddAttribute(sequence++, "aria-label", root ? "Add Admin service" : "Add child service"); builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, AddItem)); builder.AddEventStopPropagationAttribute(sequence++, "onclick", true); builder.AddContent(sequence++, "+"); builder.CloseElement(); } builder.CloseElement();
        builder.OpenElement(sequence++, "div"); builder.AddAttribute(sequence++, "class", "tree-children");
        foreach (var service in services)
        {
            builder.OpenElement(sequence++, "div"); builder.AddAttribute(sequence++, "class", "service-tree-node"); builder.AddAttribute(sequence++, "data-service", service.Id);
            builder.OpenElement(sequence++, "div"); builder.AddAttribute(sequence++, "class", "tree-row"); builder.OpenElement(sequence++, "span"); builder.AddContent(sequence++, service.Name); builder.CloseElement(); builder.CloseElement();
            foreach (var folder in new[] { "Models", "Api", "Pages", "Settings" }) { builder.OpenElement(sequence++, "div"); builder.AddAttribute(sequence++, "class", "tree-leaf"); builder.AddContent(sequence++, folder); builder.CloseElement(); }
            builder.AddContent(sequence++, TreeServices(service.Children ?? [], false)); builder.CloseElement();
        }
        builder.CloseElement(); builder.CloseElement();
    };
}
