@inject IServiceCatalog Catalog
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider Authentication
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@implements IDisposable

<section class="services-page" data-page="services">
    <div class="page-header"><h1>Services</h1><p>Extend your company with focused modules.</p></div>
    <div class="toolbar">
        <input aria-label="Search services" placeholder="Search services..." @bind="search" @bind:event="oninput" />
        <div class="filter-tabs" role="tablist">
            @foreach (var choice in Enum.GetValues<ServiceFilter>())
            {
                <button class="filter-tab @(filter == choice ? "active" : null)" @onclick="() => filter = choice">@choice</button>
            }
        </div>
    </div>
    <div class="service-grid">
        @foreach (var service in FilteredServices)
        {
            <article class="service-card" data-service="@service.Id" @onclick="() => selected = service">
                <div class="service-card-header"><span class="service-icon" style="color:@service.Color">@service.Icon</span>@if (canManage) { <button aria-label="Toggle @service.Name" class="service-toggle @(service.Enabled ? "active" : null)" @onclick="() => Toggle(service)" @onclick:stopPropagation></button> }</div>
                <h2>@service.Name</h2><p>@service.Description</p><footer><span>v@(service.Version)</span><span>@(service.Enabled ? "Enabled" : "Disabled")</span></footer>
            </article>
            @foreach (var child in service.Children ?? [])
            {
                <article class="service-card child-service" data-service="@child.Id" data-parent="@service.Id"><h2>@child.Name</h2><p>@child.Description</p></article>
            }
        }
    </div>
</section>
@if (selected is not null)
{
    <div class="modal-backdrop" @onclick="() => selected = null"><div class="service-modal" role="dialog" @onclick:stopPropagation><button aria-label="Close" @onclick="() => selected = null">×</button><h2>@selected.Name</h2><p>@selected.Description</p><dl><dt>Version</dt><dd>@selected.Version</dd><dt>Author</dt><dd>@selected.Author</dd></dl></div></div>
}

@code {
    private string search = string.Empty;
    private ServiceFilter filter;
    private ServiceSummary? selected;
    private bool canManage;
    private IEnumerable<ServiceSummary> FilteredServices => Catalog.GetServices().Where(service =>
        (filter == ServiceFilter.All || service.Enabled == (filter == ServiceFilter.Enabled)) &&
        (string.IsNullOrWhiteSpace(search) || service.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || service.Description.Contains(search, StringComparison.OrdinalIgnoreCase)));
    private async Task Toggle(ServiceSummary service)
    {
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        if (!(await Authorization.AuthorizeAsync(user, null, "ManageUsers")).Succeeded) return;
        Catalog.SetEnabled(service.Id, !service.Enabled); selected = null;
    }
    protected override async Task OnInitializedAsync()
    {
        Catalog.Changed += CatalogChanged;
        canManage = (await Authorization.AuthorizeAsync((await Authentication.GetAuthenticationStateAsync()).User, null, "ManageUsers")).Succeeded;
    }
    private void CatalogChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Catalog.Changed -= CatalogChanged;
    private enum ServiceFilter { All, Enabled, Disabled }
}
