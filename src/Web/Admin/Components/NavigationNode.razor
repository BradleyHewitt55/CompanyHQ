@using Web.Admin.Services
<div class="service-nav-node" data-nav="@Item.Label">
    @if (!string.IsNullOrWhiteSpace(Item.Path))
    {
        <a href="@Item.Path"><span>@Item.Icon</span> @Item.Label</a>
    }
    else
    {
        <div class="service-nav-parent"><span>@Item.Icon</span> @Item.Label</div>
    }
    @if (Item.Children is { Count: > 0 })
    {
        <div class="service-nav-children">
            @foreach (var child in Item.Children) { <NavigationNode Item="child" /> }
        </div>
    }
</div>

@code { [Parameter, EditorRequired] public AdminNavigationItem Item { get; set; } = null!; }
