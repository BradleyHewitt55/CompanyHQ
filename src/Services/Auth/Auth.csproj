<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Auth</AssemblyName>
    <RootNamespace>Services.Auth</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Companies\Companies.csproj" />
  </ItemGroup>
  <ItemGroup><Content Update="auth.json" CopyToOutputDirectory="PreserveNewest" /><EmbeddedResource Include="auth.json" LogicalName="service-manifest.json" /></ItemGroup>
  <ItemGroup><Compile Remove="Tests\**\*.cs" /><Content Remove="Tests\**\*" /><None Remove="Tests\**\*" /></ItemGroup>
</Project>
