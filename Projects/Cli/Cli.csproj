<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>companyhq</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\Abstractions.csproj" />
    <ProjectReference Include="..\Infrastructure\PluginDiscovery\PluginDiscovery.csproj" />
    <!-- Project references package built-ins; runtime code discovers them by contract. -->
    <ProjectReference Include="..\Services\Companies\Companies.csproj" />
    <ProjectReference Include="..\Services\Postgress\Postgress.csproj" />
    <ProjectReference Include="..\Services\Auth\Auth.csproj" />
  </ItemGroup>

</Project>
