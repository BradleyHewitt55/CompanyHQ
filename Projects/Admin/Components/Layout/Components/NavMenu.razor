@rendermode InteractiveServer
@inject Abstractions.Services.IServiceCatalog ServiceCatalog
@implements IAsyncDisposable

<div class="brand" aria-label="Web home"><span class="material-symbols-outlined">layers</span></div>
<nav>
    @if (_menuItems is not null && _menuItems.Count > 0)
    {
        @foreach (var item in _menuItems)
        {
            @RenderMenuItem(item)
        }
    }
    <NavLink href="/services" Match="NavLinkMatch.Prefix" class="nav-item">
        <span class="material-symbols-outlined">tune</span>Services
    </NavLink>
</nav>

@code {
    private IReadOnlyList<Abstractions.Services.ServiceMenuItem>? _menuItems;
    private HashSet<string> _expandedGroups = [];

    protected override void OnInitialized()
    {
        _menuItems = ServiceCatalog.GetNavMenuItems();
    }

    private void ToggleGroup(string label)
    {
        if (_expandedGroups.Contains(label))
            _expandedGroups.Remove(label);
        else
            _expandedGroups.Add(label);
    }

    private RenderFragment RenderMenuItem(Abstractions.Services.ServiceMenuItem item) => @<text>
        @if (item.Children?.Count > 0)
        {
            bool isExpanded = _expandedGroups.Contains(item.Label);
            <div class="menu-group">
                <button class="@($"group-toggle{(isExpanded ? " expanded" : "")}")"
                        @onclick="() => ToggleGroup(item.Label)">
                    <span>@item.Label</span>
                    <span class="material-symbols-outlined chevron">expand_more</span>
                </button>
                @if (isExpanded)
                {
                    <div class="menu-children">
                        @foreach (var child in item.Children)
                        {
                            @RenderMenuItem(child)
                        }
                    </div>
                }
            </div>
        }
        else if (!string.IsNullOrEmpty(item.Path))
        {
            <NavLink href="@item.Path" class="nav-item">
                @if (!string.IsNullOrEmpty(item.Icon))
                {
                    <span class="material-symbols-outlined">@item.Icon</span>
                }
                @item.Label
            </NavLink>
        }
    </text>;

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        _expandedGroups?.Clear();
        await ValueTask.CompletedTask;
    }
}
